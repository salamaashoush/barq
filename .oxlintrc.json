{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-underscore-dangle": "off",
    // `scope`, `owner`, `element` and `context` are this codebase's DOMAIN
    // nouns and also the names of four exported functions in the same modules,
    // so 65 of the rule's 125 hits were a correct parameter name colliding with
    // an API name. Renaming those parameters would make §3.2's calling
    // convention unreadable to keep a lint quiet. Everything else is fixed.
    "no-shadow": ["error", { "allow": ["scope", "owner", "element", "context"] }],
    "no-unmodified-loop-condition": "error",

    // `globalCss\`…\`` is a statement, and that IS the API: the tag registers
    // the rules and returns nothing. `@barqjs/css`'s own README writes it that
    // way, so the alternative to this option is a dead binding in every module
    // that declares a stylesheet.
    "no-unused-expressions": ["error", { "allowTaggedTemplates": true }],

    "no-unused-vars": "error",
    "no-console": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "no-await-in-loop": "off",

    "unicorn/no-null": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/prefer-dom-node-append": "off",
    "unicorn/prefer-string-replace-all": "off",
    "unicorn/prefer-string-raw": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/prefer-spread": "off",
    "unicorn/prefer-array-flat-map": "off",

    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "@typescript-eslint/ban-ts-comment": "off",
    "@typescript-eslint/await-thenable": "error",
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/no-misused-promises": "error",
    // Off: promise-returning API contracts (resource fetchers, route loaders,
    // action bodies) are legitimately `async` with no `await` inside - the
    // keyword is the return-type guarantee, not dead syntax.
    "@typescript-eslint/require-await": "off",
    "@typescript-eslint/no-unnecessary-type-assertion": "error",
    "@typescript-eslint/no-unnecessary-type-parameters": "error",
    "@typescript-eslint/no-unnecessary-type-conversion": "error",
    "@typescript-eslint/consistent-return": "error",
    "@typescript-eslint/no-unsafe-type-assertion": "off",
    "@typescript-eslint/no-unsafe-argument": "warn",

    // A `.css.ts` module has nothing to export: it registers rules, and the
    // import is how a component says "the layer order has to be declared before
    // mine". `@barqjs/ui` has one per component, and the alternative — a dead
    // binding and a `void` beside it — is noise standing in for the same claim.
    //
    // A stylesheet is the same claim in the other direction: `import
    // "@fontsource-variable/geist/index.css"` is how a bundle says the face has
    // to be in the document, and there is no binding it could produce.
    //
    // `@barqjs/web/host` is a third: it installs the document as the host
    // core's components render through, which is the whole of what it does.
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/layers.ts",
          "**/base.ts",
          "**/reset.ts",
          "**/register-dom.ts",
          "@barqjs/web/host",
          "./host.ts",
          "**/*.css",
          "**/theme.ts"
        ]
      }
    ],
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/group-exports": "off",

    "promise/no-nesting": "off",
    // Off: the runtime's internal settle handlers are terminal side-effect
    // arms, not links in a value-producing chain.
    "promise/always-return": "off",
    // Off: fights the factory pattern the primitives are built on, where inner
    // closures capture the factory's state by design.
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/profile-hot.ts"],
      "rules": {
        "@typescript-eslint/await-thenable": "off",
        "@typescript-eslint/unbound-method": "off",
        "@typescript-eslint/no-base-to-string": "off",
        "@typescript-eslint/restrict-template-expressions": "off"
      }
    },
    {
      // `AnyRouteDefinition` is an existential: a table holds routes whose
      // `Data` is read by the loader and handed to the component, so the
      // parameter is invariant and no type but `any` admits every route.
      // TypeScript has no other spelling for it, and the alias is the only
      // `any` in the file.
      "files": ["packages/router/src/route.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      // `installSeed` runs a server-rendered seed script the way a browser
      // runs the tag carrying it, in the global scope. An indirect `eval` is
      // that operation; anything else is a different one.
      "files": ["packages/testing/src/hydrate.ts"],
      "rules": {
        "no-eval": "off"
      }
    },
    {
      // `no-thenable` stops an object becoming awaitable by accident. Here the
      // `then` is the subject under test: A7 claims the runtime asks for the
      // Promises/A+ shape rather than `instanceof Promise`, and only an object
      // that has one can observe that.
      "files": ["packages/core/src/async-source.test.ts"],
      "rules": {
        "unicorn/no-thenable": "off"
      }
    },
    {
      // The modality tracker wraps `HTMLElement.prototype.focus` and re-applies
      // the `this` each call arrives with, so capturing the method unbound is
      // the mechanism rather than a mistake.
      "files": ["packages/aria/src/interactions/modality.ts"],
      "rules": {
        "@typescript-eslint/unbound-method": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "packages/core/solid-parity/**"
  ]
}
