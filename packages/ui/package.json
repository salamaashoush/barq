    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run registry && bun run build",
    "exports": "bun run tools/exports.ts",
    "registry": "bun run tools/registry.ts",
    "verify": "bun --preload ./src/test-setup.ts tools/verify.ts",
