{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noEmitOnError": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "@barqjs/core"
  },
  // `fixtures/` is its own project, `fixtures/tsconfig.json`: some fixtures are
  // compiler input that is deliberately not valid TypeScript.
  "include": ["test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["node_modules", "target", "test/.tmp"]
}
