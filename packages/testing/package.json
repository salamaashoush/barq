{
  "name": "@barqjs/testing",
  "version": "0.1.0",
  "description": "Testing utilities for Barq components",
  "keywords": [
    "barq",
    "testing",
    "testing-library"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "bun": "./src/pure.ts",
      "import": "./dist/pure.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "bun": "./src/router.ts",
      "import": "./dist/router.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe src",
    "format": "bunx @biomejs/biome format --write src",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/css": "workspace:*",
    "@barqjs/primitives": "workspace:*",
    "@barqjs/router": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@barqjs/start": "workspace:*",
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.4.0",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/router": ">=0.1.0",
    "@barqjs/server": ">=0.1.0",
    "@barqjs/start": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@barqjs/router": {
      "optional": true
    },
    "@barqjs/start": {
      "optional": true
    }
  }
}
