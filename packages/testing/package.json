{
  "name": "@barqjs/testing",
  "version": "0.1.0",
  "description": "Testing utilities for barq: components, user events, accessibility checks, routes, hydration and server functions",
  "keywords": [
    "barq",
    "testing",
    "testing-library"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts",
    "!src/preload.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "bun": "./src/pure.ts",
      "import": "./dist/pure.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "bun": "./src/router.ts",
      "import": "./dist/router.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "bun": "./src/a11y.ts",
      "import": "./dist/a11y.js"
    },
    "./user": {
      "types": "./dist/user.d.ts",
      "bun": "./src/user.ts",
      "import": "./dist/user.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun test --conditions=development"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/css": "workspace:*",
    "@barqjs/primitives": "workspace:*",
    "@barqjs/router": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@barqjs/start": "workspace:*",
    "@barqjs/vite": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/router": ">=0.1.0",
    "@barqjs/server": ">=0.1.0",
    "@barqjs/start": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@barqjs/router": {
      "optional": true
    },
    "@barqjs/start": {
      "optional": true
    }
  }
}
