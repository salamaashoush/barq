{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The declaration build runs the compiler with `rootDir` set to this
    // package. A source file from outside it (another package's `src`, reached
    // by an import) is an error there and is still emitted, beside that source.
    // Stopping on the error is what keeps a build from writing into a sibling.
    "noEmitOnError": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@barqjs/web",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@types/bun"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
