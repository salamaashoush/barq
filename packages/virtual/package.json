{
  "name": "@barqjs/virtual",
  "version": "0.2.0-next.0",
  "description": "Virtualized scrolling for barq: createVirtualizer and createWindowVirtualizer, on @tanstack/virtual-core",
  "keywords": [
    "barq",
    "headless",
    "tanstack",
    "virtual",
    "virtualization"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/virtual"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test --timeout 10000 && bun test --timeout 10000 --conditions=development",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/virtual-core": "^3.19.5"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@barqjs/vite": "workspace:*",
    "@barqjs/web": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.2.0-next.0",
    "@barqjs/web": ">=0.2.0-next.0"
  }
}
