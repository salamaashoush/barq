{
  "name": "@barqjs/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "bun run src/run.ts",
    "bench:browser": "bun run src/server.ts",
    "bench:ssr": "bun run src/ssr-head-to-head.ts",
    "bench:dom": "bun --conditions=browser run src/dom-head-to-head.ts",
    "bench:replace-all": "bun --conditions=browser run src/dom-replace-all.ts",
    "bench:shape": "bun --conditions=browser run src/dom-emitted-shape.ts",
    "bench:flags": "bun --conditions=browser run src/flow-flags.ts",
    "bench:spread": "bun run src/protocol-spread.ts",
    "bench:eleven": "bun run src/eleven-h2h.ts",
    "bench:eleven-paired": "bun run src/eleven-report.ts",
    "bench:tier2": "bun run src/tier2/run.ts",
    "bench:tier2:shapes": "bun run src/tier2/run.ts shapes",
    "bench:tier2:jfb": "bun run src/tier2/run.ts jfb",
    "bench:tier2:jrb": "bun run src/tier2/run.ts jrb",
    "bench:solid2": "bun run src/solid2/run.ts",
    "bench:solid2:prepare": "bun run src/solid2/prepare.ts",
    "build": "bun build src/browser.ts --outdir dist --target browser --format esm",
    "bench:static": "bun run src/static-lookup.ts",
    "bench:three": "bun run src/three/run.ts"
  },
  "dependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@barqjs/compiler": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@barqjs/start": "workspace:*",
    "@barqjs/three": "workspace:*",
    "@barqjs/universal": "workspace:*",
    "@barqjs/web": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@react-three/fiber": "9.8.2",
    "@solidjs/signals": "2.0.0-rc.15",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.3",
    "@types/react": "^19",
    "@types/three": "^0.186.0",
    "babel-preset-solid": "^1.9.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  }
}
