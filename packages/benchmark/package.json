{
  "name": "@barqjs/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "bun run src/run.ts",
    "bench:browser": "bun run src/server.ts",
    "bench:ssr": "bun run src/ssr-head-to-head.ts",
    "bench:dom": "bun --conditions=browser run src/dom-head-to-head.ts",
    "bench:replace-all": "bun --conditions=browser run src/dom-replace-all.ts",
    "bench:shape": "bun --conditions=browser run src/dom-emitted-shape.ts",
    "bench:flags": "bun --conditions=browser run src/flow-flags.ts",
    "bench:spread": "bun run src/protocol-spread.ts",
    "bench:eleven": "bun run src/eleven-h2h.ts",
    "bench:eleven-paired": "bun run src/eleven-report.ts",
    "build": "bun build src/browser.ts --outdir dist --target browser --format esm"
  },
  "dependencies": {
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@babel/core": "^7.28.6",
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@happy-dom/global-registrator": "^15.11.7",
    "@solidjs/signals": "^2.0.0-beta.31",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "babel-preset-solid": "^1.9.12",
    "typescript": "^5.7.2"
  }
}
