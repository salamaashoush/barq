{
  "name": "@barqjs/server",
  "version": "0.1.0",
  "description": "Barq server rendering: the SSR string backend, streaming, and the hydration seed channel.",
  "keywords": [
    "barq",
    "hydration",
    "server",
    "ssr",
    "streaming"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "bun": "./src/codec.ts",
      "import": "./dist/codec.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe src",
    "format": "bunx @biomejs/biome format --write src",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "seroval": "^1.6.2"
  },
  "devDependencies": {
    "@barqjs/core": "workspace:*",
    "@biomejs/biome": "^2.5.9",
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.4.0",
    "reactive-framework-test-suite": "^0.0.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0"
  }
}
