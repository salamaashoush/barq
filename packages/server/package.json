{
  "name": "@barqjs/server",
  "version": "0.1.0",
  "description": "Server rendering for barq: renderToString, renderToStream with per-boundary timeouts, and the hydration seed",
  "keywords": [
    "barq",
    "hydration",
    "server",
    "ssr",
    "streaming"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "imports": {
    "#serializer": {
      "types": "./src/serializer.ts",
      "bun": "./src/serializer.ts",
      "default": "./dist/serializer.js"
    },
    "#swap": {
      "types": "./src/swap.ts",
      "bun": "./src/swap.ts",
      "default": "./dist/swap.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "bun": "./src/codec.ts",
      "import": "./dist/codec.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "bun": "./src/storage.ts",
      "import": "./dist/storage.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 10000 && bun test --timeout 10000 --conditions=development"
  },
  "dependencies": {
    "seroval": "^1.6.9"
  },
  "devDependencies": {
    "@barqjs/core": "workspace:*",
    "@barqjs/web": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/web": ">=0.1.0"
  }
}
