{
  "name": "@barqjs/arc",
  "version": "0.2.0-next.4",
  "description": "barq's design system: themes, app shell, pages, data tables, form fields and the patterns every product repeats, on @barqjs/ui's accessible components",
  "keywords": [
    "accessibility",
    "barq",
    "components",
    "design-system",
    "themes"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/arc"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/compile-setup.ts",
    "!src/register-dom.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./src/theme/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "barq": "./src/index.ts",
      "bun": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "barq": "./src/theme/index.ts",
      "bun": "./src/theme/index.ts"
    },
    "./style": {
      "types": "./src/style/index.ts",
      "barq": "./src/style/index.ts",
      "bun": "./src/style/index.ts"
    },
    "./code": {
      "types": "./src/code/index.ts",
      "barq": "./src/code/index.ts",
      "bun": "./src/code/index.ts"
    },
    "./code/worker": {
      "types": "./src/code/worker.ts",
      "barq": "./src/code/worker.ts",
      "bun": "./src/code/worker.ts"
    },
    "./chat": {
      "types": "./src/chat/index.ts",
      "barq": "./src/chat/index.ts",
      "bun": "./src/chat/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "barq": "./src/editor/index.ts",
      "bun": "./src/editor/index.ts"
    },
    "./editor/collaboration": {
      "types": "./src/editor/collaboration.tsx",
      "barq": "./src/editor/collaboration.tsx",
      "bun": "./src/editor/collaboration.tsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 10000 && bun test --timeout 10000 --conditions=development"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/lsp-client": "^6.3.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lexical/clipboard": "0.53.0",
    "@lexical/code-core": "0.53.0",
    "@lexical/extension": "0.53.0",
    "@lexical/history": "0.53.0",
    "@lexical/html": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/table": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@lexical/yjs": "0.53.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/charts": "^1.5.0",
    "emojibase-data": "^18.0.0",
    "fflate": "^0.8.3",
    "lexical": "0.53.0",
    "mammoth": "^1.13.0",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@barqjs/aria": "workspace:*",
    "@barqjs/compiler": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/css": "workspace:*",
    "@barqjs/db": "workspace:*",
    "@barqjs/form": "workspace:*",
    "@barqjs/lexical": "workspace:*",
    "@barqjs/lucide": "workspace:*",
    "@barqjs/primitives": "workspace:*",
    "@barqjs/router": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@barqjs/table": "workspace:*",
    "@barqjs/testing": "workspace:*",
    "@barqjs/ui": "workspace:*",
    "@barqjs/vite": "workspace:*",
    "@barqjs/web": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "@barqjs/aria": ">=0.2.0-next.4",
    "@barqjs/core": ">=0.2.0-next.4",
    "@barqjs/css": ">=0.2.0-next.4",
    "@barqjs/db": ">=0.2.0-next.4",
    "@barqjs/form": ">=0.2.0-next.4",
    "@barqjs/lexical": ">=0.2.0-next.4",
    "@barqjs/lucide": ">=0.2.0-next.4",
    "@barqjs/primitives": ">=0.2.0-next.4",
    "@barqjs/router": ">=0.2.0-next.4",
    "@barqjs/server": ">=0.2.0-next.4",
    "@barqjs/table": ">=0.2.0-next.4",
    "@barqjs/ui": ">=0.2.0-next.4",
    "@barqjs/web": ">=0.2.0-next.4",
    "yjs": ">=13.5.37"
  },
  "peerDependenciesMeta": {
    "@barqjs/db": {
      "optional": true
    },
    "@barqjs/lexical": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
