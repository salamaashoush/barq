{
  "name": "@barqjs/extra",
  "version": "0.1.0",
  "description": "Extra utilities for Barq: the TanStack Query adapter, and the hook-shaped names over @barqjs/primitives",
  "keywords": [
    "barq",
    "clsx",
    "css-in-js",
    "query",
    "router",
    "variants"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/extra"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe src",
    "format": "bunx @biomejs/biome format --write src",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.101.4"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/css": "workspace:*",
    "@barqjs/primitives": "workspace:*",
    "@biomejs/biome": "^2.5.9",
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/primitives": ">=0.1.0",
    "@tanstack/query-core": "^5.101.4"
  }
}
