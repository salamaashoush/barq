{
  "name": "@barqjs/lucide",
  "version": "0.1.0",
  "description": "Every lucide icon as a Barq component, generated from lucide-static",
  "keywords": [
    "barq",
    "icons",
    "lucide",
    "svg"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/lucide"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "barq": "./src/index.ts",
      "bun": "./src/index.ts"
    },
    "./icon": {
      "types": "./src/icon.ts",
      "barq": "./src/icon.ts",
      "bun": "./src/icon.ts"
    },
    "./icons/*": {
      "types": "./src/icons/*.tsx",
      "barq": "./src/icons/*.tsx",
      "bun": "./src/icons/*.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "bun run tools/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/testing": "workspace:*",
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.4.0",
    "lucide-static": "^1.37.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/server": ">=0.1.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "peerDependenciesMeta": {}
}
