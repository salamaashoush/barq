{
  "name": "@barqjs/lucide",
  "version": "0.1.0",
  "description": "Every lucide icon as a Barq component, generated from lucide-static",
  "keywords": [
    "barq",
    "icons",
    "lucide",
    "svg"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/lucide"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "bun": "./src/icon.ts",
      "import": "./dist/icon.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "bun": "./src/icons/*.tsx",
      "import": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "generate": "bun run tools/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/testing": "workspace:*",
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.4.0",
    "lucide-static": "^1.37.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
