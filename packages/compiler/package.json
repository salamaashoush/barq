{
  "name": "@barqjs/compiler",
  "version": "0.1.0",
  "description": "Barq compiler - transforms clean JSX into fine-grained reactive code",
  "keywords": [
    "barq",
    "compiler",
    "babel-plugin",
    "jsx",
    "reactive",
    "signals"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/compiler"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "bun": "./src/babel.ts",
      "import": "./dist/babel.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "bun": "./src/vite.ts",
      "import": "./dist/vite.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@babel/helper-plugin-utils": "^7.24.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.24.0",
    "@barqjs/core": "workspace:*",
    "@happy-dom/global-registrator": "^20.3.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@babel/core": ">=7.20.0",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
