{
  "name": "@barqjs/compiler",
  "version": "0.1.0",
  "description": "Barq compiler - Vite integration for the native JSX transform",
  "keywords": [
    "barq",
    "compiler",
    "vite-plugin",
    "jsx",
    "reactive",
    "signals"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/compiler"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "bun": "./src/vite.ts",
      "import": "./dist/vite.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@barqjs/compiler-rs": "workspace:*"
  },
  "devDependencies": {
    "@barqjs/core": "workspace:*",
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
