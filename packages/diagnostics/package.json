{
  "name": "@barqjs/diagnostics",
  "version": "0.2.0-next.3",
  "description": "Agent-consumable diagnostics for barq: capture findings and attribution as one artifact, with assertions, budgets, test matchers, a browser bridge and a dev-server endpoint",
  "keywords": [
    "agents",
    "attribution",
    "barq",
    "diagnostics",
    "testing"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/diagnostics"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.vitest.ts",
    "!src/**/*.vitest.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts",
    "!src/preload.ts",
    "!src/register-dom.ts",
    "!src/vitest-setup.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "bun": "./src/matchers.ts",
      "import": "./dist/matchers.js"
    },
    "./matchers/bun": {
      "types": "./dist/matchers-bun.d.ts",
      "bun": "./src/matchers-bun.ts",
      "import": "./dist/matchers-bun.js"
    },
    "./matchers/vitest": {
      "types": "./dist/matchers-vitest.d.ts",
      "bun": "./src/matchers-vitest.ts",
      "import": "./dist/matchers-vitest.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "bun": "./src/browser.ts",
      "import": "./dist/browser.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "bun": "./src/playwright.ts",
      "import": "./dist/playwright.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "import": "./dist/protocol.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "bun": "./src/vite.ts",
      "import": "./dist/vite.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun test --conditions=development && vitest run"
  },
  "dependencies": {
    "@solidjs/signals": "2.0.3"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/testing": "workspace:*",
    "@barqjs/vite": "workspace:*",
    "@barqjs/web": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.2.0-next.3",
    "vite": ">=8.0.0",
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
