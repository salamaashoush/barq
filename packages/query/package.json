{
  "name": "@barqjs/query",
  "version": "0.1.0",
  "description": "Data fetching and caching for barq: queries, mutations and infinite queries, on @tanstack/query-core",
  "keywords": [
    "async",
    "barq",
    "cache",
    "query",
    "tanstack"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/query"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts",
    "!src/ssr-server.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "bun": "./src/devtools.ts",
      "import": "./dist/devtools.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "bun": "./src/persist.ts",
      "import": "./dist/persist.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "bun": "./src/router.ts",
      "import": "./dist/router.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test --timeout 10000 && bun test --timeout 10000 --conditions=development",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.104.3"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/router": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@barqjs/vite": "workspace:*",
    "@barqjs/web": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@tanstack/query-devtools": "5.104.3",
    "@tanstack/query-persist-client-core": "5.104.3",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/router": ">=0.1.0",
    "@barqjs/web": ">=0.1.0",
    "@tanstack/query-core": "^5.104.3",
    "@tanstack/query-devtools": "^5.104.3",
    "@tanstack/query-persist-client-core": "^5.104.3"
  },
  "peerDependenciesMeta": {
    "@barqjs/router": {
      "optional": true
    },
    "@tanstack/query-devtools": {
      "optional": true
    },
    "@tanstack/query-persist-client-core": {
      "optional": true
    }
  }
}
