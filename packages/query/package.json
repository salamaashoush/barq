{
  "name": "@barqjs/query",
  "version": "0.1.0",
  "description": "TanStack Query for Barq: useQuery, useMutation, useInfiniteQuery, over @tanstack/query-core",
  "keywords": [
    "async",
    "barq",
    "cache",
    "query",
    "tanstack"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/query"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.102.8"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@tanstack/query-core": "^5.102.8"
  }
}
