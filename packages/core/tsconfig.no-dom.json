{
  // Everything core ships, checked with no DOM in scope: a document type or
  // global in any of it, or in anything it imports, is an error here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": []
  },
  "include": ["host-globals.d.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-*.ts"]
}
