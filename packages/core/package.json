{
  "name": "@barqjs/core",
  "version": "0.1.0",
  "description": "Signals, stores, control flow, JSX and the DOM renderer for barq: fine-grained updates with no virtual DOM",
  "keywords": [
    "barq",
    "fine-grained",
    "framework",
    "jsx",
    "reactive",
    "signals",
    "ui"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts",
    "!src/jsx-types"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#env": {
      "types": "./src/env.ts",
      "worker": "./dist/env.server.js",
      "workerd": "./dist/env.server.js",
      "browser": "./dist/env.client.js",
      "bun": "./src/env.ts",
      "deno": "./dist/env.server.js",
      "node": "./dist/env.server.js",
      "default": "./dist/env.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": {
        "bun": "./src/dev.ts",
        "import": "./dist/dev.js"
      },
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./hot": {
      "types": "./dist/hot.d.ts",
      "bun": "./src/hot.ts",
      "import": "./dist/hot.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "bun": "./src/internal.ts",
      "import": "./dist/internal.js"
    },
    "./interp": {
      "types": "./dist/interp.d.ts",
      "bun": "./src/interp.ts",
      "import": "./dist/interp.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "bun": "./src/jsx-runtime.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "bun": "./src/jsx-runtime.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.conformance.json",
    "test": "bun test --timeout 10000 && bun test --timeout 10000 --conditions=development"
  },
  "dependencies": {
    "@solidjs/signals": "2.0.0-rc.15",
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@barqjs/compiler-rs": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/bun": "^1.4.3",
    "reactive-framework-test-suite": "^0.1.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
