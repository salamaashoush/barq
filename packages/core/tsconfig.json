{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noEmitOnError": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@types/bun"],
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": true
  },
  "include": ["src/**/*.ts"],
  // `conformance.test.ts` imports a third-party suite that ships TypeScript
  // source and fails `noUnusedLocals`; `skipLibCheck` does not reach a `.ts`
  // file, so the suite would be checked as if it were this package.
  // `tsconfig.conformance.json` checks that test against the suite instead.
  "exclude": ["node_modules", "dist", "src/conformance.test.ts"]
}
