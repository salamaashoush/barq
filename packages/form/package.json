{
  "name": "@barqjs/form",
  "version": "0.1.0",
  "description": "TanStack Form for Barq: createForm, createField and Subscribe over @tanstack/form-core",
  "keywords": [
    "barq",
    "form",
    "headless",
    "tanstack",
    "validation"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/form"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test && bun test --conditions=development",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@tanstack/form-core": "^1.33.5",
    "@tanstack/store": "^0.11.2"
  },
  "devDependencies": {
    "@barqjs/compiler": "workspace:*",
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0"
  }
}
