{
  "name": "@barqjs/vite",
  "version": "0.2.0-next.0",
  "description": "The barq Vite plugin: the compiler, file routes, compiled styles and the server build, from one call",
  "keywords": [
    "barq",
    "ssr",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist",
    "boundary-modules.d.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "bun": "./src/internal.ts",
      "import": "./dist/internal.js"
    },
    "./boundary-modules": {
      "types": "./boundary-modules.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun test --conditions=development"
  },
  "dependencies": {
    "@barqjs/compiler": "workspace:*",
    "srvx": "^1.0.5"
  },
  "devDependencies": {
    "@barqjs/core": "workspace:*",
    "@barqjs/css": "workspace:*",
    "@barqjs/router": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@barqjs/start": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "@barqjs/router": ">=0.2.0-next.0",
    "@barqjs/start": ">=0.2.0-next.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@barqjs/router": {
      "optional": true
    },
    "@barqjs/start": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
