{
  "name": "@barqjs/start",
  "version": "0.1.0",
  "description": "Server functions, middleware, sessions, cookies and the built server for barq",
  "keywords": [
    "barq",
    "rpc",
    "server-functions",
    "ssr"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/start"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "bun": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "bun": "./src/middleware.ts",
      "import": "./dist/middleware.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "bun": "./src/env.ts",
      "import": "./dist/env.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "bun": "./src/serve.ts",
      "import": "./dist/serve.js"
    },
    "./prerender": {
      "types": "./dist/prerender.d.ts",
      "bun": "./src/prerender.ts",
      "import": "./dist/prerender.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun test --conditions=development"
  },
  "dependencies": {
    "@barqjs/css": "workspace:*",
    "srvx": "^1.0.5"
  },
  "devDependencies": {
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/server": ">=0.1.0"
  },
  "engines": {
    "node": ">=20.16.0"
  }
}
