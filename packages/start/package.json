{
  "name": "@barqjs/start",
  "version": "0.1.0",
  "description": "Barq server functions: the builder, the RPC wire, and the request handler.",
  "keywords": [
    "barq",
    "rpc",
    "server-functions",
    "ssr"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/start"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe src",
    "format": "bunx @biomejs/biome format --write src",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@barqjs/core": "workspace:*",
    "@barqjs/server": "workspace:*",
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0",
    "@barqjs/server": ">=0.1.0"
  }
}
