{
  "name": "@barqjs/table",
  "version": "0.1.0",
  "description": "Headless tables for barq: createTable, FlexRender and createTableHook, on @tanstack/table-core",
  "keywords": [
    "barq",
    "datagrid",
    "headless",
    "table",
    "tanstack"
  ],
  "homepage": "https://github.com/salamaashoush/barq#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/barq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/barq.git",
    "directory": "packages/table"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-*.ts",
    "!src/**/*-harness.ts",
    "!src/**/*-probe.ts",
    "!src/**/fixtures",
    "!src/**/fixtures.ts",
    "!src/**/ssr-fixtures.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./experimental-worker-plugin": {
      "types": "./dist/experimental-worker-plugin.d.ts",
      "bun": "./src/experimental-worker-plugin.ts",
      "import": "./dist/experimental-worker-plugin.js"
    },
    "./flex-render": {
      "types": "./dist/flex-render.d.ts",
      "bun": "./src/flex-render.ts",
      "import": "./dist/flex-render.js"
    },
    "./static-functions": {
      "types": "./dist/static-functions.d.ts",
      "bun": "./src/static-functions.ts",
      "import": "./dist/static-functions.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test --timeout 10000 && bun test --timeout 10000 --conditions=development",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/store": "^0.11.2",
    "@tanstack/table-core": "^9.3.1"
  },
  "devDependencies": {
    "@barqjs/compiler-rs": "workspace:*",
    "@barqjs/core": "workspace:*",
    "@barqjs/vite": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@barqjs/core": ">=0.1.0"
  }
}
